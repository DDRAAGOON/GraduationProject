turn Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<Map<String, dynamic>> register({\r\n    required String email,\r\n    required String password,\r\n    required String name,\r\n    required String role,\r\n  }) async {\r\n    final Response<dynamic> response = await _dio.post<dynamic>(\r\n      ApiEndpoints.register,\r\n      data: <String, dynamic>{\r\n        'email': email,\r\n        'password': password,\r\n        'name': name,\r\n        'role': role,\r\n      },\r\n    );\r\n    return Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<Map<String, dynamic>> updateProfile({\r\n    String? name,\r\n    String? photoUrl,\r\n  }) async {\r\n    final Response<dynamic> response = await _dio.put<dynamic>(\r\n      '/api/auth/profile',\r\n      data: <String, dynamic>{\r\n        if (name != null) 'name': name,\r\n        if (photoUrl != null) 'photoUrl': photoUrl,\r\n      },\r\n      options: _authOptions,\r\n    );\r\n    return Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<List<Map<String, dynamic>>> fetchJobs() async {\r\n    final Response<dynamic> response = await _dio.get<dynamic>(\r\n      ApiEndpoints.jobs,\r\n      options: _authOptions,\r\n    );\r\n    return (response.data as List<dynamic>)\r\n        .map((dynamic e) => Map<String, dynamic>.from(e as Map))\r\n        .toList();\r\n  }\r\n\r\n  Future<List<Map<String, dynamic>>> fetchApplications() async {\r\n    final Response<dynamic> response = await _dio.get<dynamic>(\r\n      ApiEndpoints.applications,\r\n      options: _authOptions,\r\n    );\r\n    return (response.data as List<dynamic>)\r\n        .map((dynamic e) => Map<String, dynamic>.from(e as Map))\r\n        .toList();\r\n  }\r\n\r\nFuture<Map<String, dynamic>> createJob({\r\n    required String title,\r\n    required String companyName,\r\n    required String location,\r\n    required String salaryRange,\r\n    required String type,\r\n    required List<String> tags,\r\n    required String category,\r\n    int requiredCount = 1,\r\n  }) async {\r\n    final Response<dynamic> response = await _dio.post<dynamic>(\r\n      ApiEndpoints.jobs,\r\n      data: <String, dynamic>{\r\n        'title': title,\r\n        'companyName': companyName,\r\n        'location': location,\r\n        'salaryRange': salaryRange,\r\n        'type': type,\r\n        'tags': tags,\r\n        'category': category,\r\n        'requiredCount': requiredCount,\r\n      },\r\n      options: _authOptions,\r\n    );\r\n    return Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<Map<String, dynamic>> createApplication({\r\n    required String jobId,\r\n    required String userName,\r\n  }) async {\r\n    final Response<dynamic> response = await _dio.post<dynamic>(\r\n      ApiEndpoints.applications,\r\n      data: <String, dynamic>{'jobId': jobId, 'userName': userName},\r\n      options: _authOptions,\r\n    );\r\n    return Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<Map<String, dynamic>> updateApplicationStatus({\r\n    required String applicationId,\r\n    required String status,\r\n  }) async {\r\n    final String path = ApiEndpoints.applicationStatus.replaceFirst(\r\n      '{id}',\r\n      applicationId,\r\n    );\r\n    final Response<dynamic> response = await _dio.patch<dynamic>(\r\n      path,\r\n      data: <String, dynamic>{'status': status},\r\n      options: _authOptions,\r\n    );\r\n    return Map<String, dynamic>.from(response.data as Map);\r\n  }\r\n\r\n  Future<List<Map<String, dynamic>>> fetchMessages() async {\r\n    final Response<dynamic> response = await _dio.get<dynamic>(\r\n      ApiEndpoints.messages,\r\n      options: _authOptions,\r\n    );\r\n    return (response.data as List<dynamic>)\r\n        .map((dynamic e) => Map<String, dynamic>.from(e as Map))\r\n        .toList();\r\n  }\r\n\r\n  Future<void> sendMessage(String text) async {\r\n    await _dio.post<dynamic>(\r\n      ApiEndpoints.messages,\r\n      data: <String, dynamic>{'text': text},\r\n      options: _authOptions,\r\n    );\r\n  }\r\n}\r\n
