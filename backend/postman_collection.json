{
  "info": {
    "name": "Jobito Recruitment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login Company",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"company@jobito.com\",\n  \"password\": \"12345678\"\n}" }
      }
    },
    {
      "name": "Get Jobs",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] }
      }
    },
    {
      "name": "Post Job",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Node Backend Engineer\",\n  \"companyName\": \"Jobito Labs\",\n  \"location\": \"Remote\",\n  \"salaryRange\": \"30k - 45k EGP\",\n  \"type\": \"Full-time\",\n  \"tags\": [\"Node.js\", \"Express\"]\n}" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" }
  ]
}
